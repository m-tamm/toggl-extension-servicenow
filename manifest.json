{
  "manifest_version": 3,
  "name": "Tracker Day Import Helper",
  "description": "Fetch day entries from Toggl or Super Productivity and import a selected entry date into the current page. (Built for ServiceNow)",
  "version": "0.9.0",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://api.track.toggl.com/*",
    "http://127.0.0.1:3876/*",
    "http://localhost:3876/*"
  ],
  "action": {
    "default_title": "Tracker Import",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
